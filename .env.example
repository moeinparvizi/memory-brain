# ─── Database ───
DB_PASSWORD=supersecretpassword
POSTGRES_USER=moein
POSTGRES_DB=moein_dashboard

# ─── Backend ───
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
CORS_ORIGIN=http://localhost:4200

# ─── Single-user auth ───
AUTH_USERNAME=moein
